rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net - default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidNote(data) {
      return data.baslik is string && data.baslik.size() > 0 && data.baslik.size() <= 300 &&
        (!('zaman' in data) || data.zaman == null || (data.zaman is string && data.zaman.size() <= 200)) &&
        (!('tarih_iso' in data) || data.tarih_iso == null || (data.tarih_iso is string && data.tarih_iso.size() <= 100)) &&
        (!('calendar_event_id' in data) || data.calendar_event_id == null || (data.calendar_event_id is string && data.calendar_event_id.size() <= 256)) &&
        (!('calendarEventId' in data) || data.calendarEventId == null || (data.calendarEventId is string && data.calendarEventId.size() <= 256)) &&
        data.ikon is string && data.ikon.size() <= 20 &&
        data.renk is string && data.renk.size() <= 20;
    }

    // User personal notes collection
    match /users/{userId}/notes/{noteId} {
      allow list, get: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId && isValidId(noteId) && isValidNote(incoming());
      allow update: if isSignedIn() && request.auth.uid == userId && isValidId(noteId) && isValidNote(incoming());
      allow delete: if isSignedIn() && request.auth.uid == userId && isValidId(noteId);
    }
  }
}
